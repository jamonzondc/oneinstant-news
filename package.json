{
  "name": "oneinstant-news",
  "version": "1.1.0",
  "private": true,
  "description": "Ultra-light news reader for emergencies: text-only feeds, minimal network and battery usage.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"contract/**/*.test.ts\" \"pipeline/**/*.test.ts\" \"web/test/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"web/e2e/**/*.e2e.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && tsc -p web/sw/tsconfig.json",
    "build": "npm run build:data && npm run build:web",
    "build:data": "node pipeline/src/cli.ts",
    "build:data:fixtures": "node pipeline/src/cli.ts --sources fixtures",
    "build:web": "node web/tools/build.ts",
    "serve": "node web/tools/serve.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
